{
  "name": "@macalinao/style-guide",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo containing ESLint and TypeScript configurations.",
  "keywords": [],
  "license": "Apache-2.0",
  "author": "Ian Macalinao <me@ianm.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/macalinao/style-guide.git"
  },
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@biomejs/biome": "2.5.4",
      "eslint": "^10.7.0",
      "eslint-config-turbo": "2.9.18",
      "oxfmt": "0.59.0",
      "oxlint": "1.73.0",
      "oxlint-tsgolint": "0.25.0",
      "turbo": "2.9.18",
      "typescript": "5.9.3",
      "typescript-eslint": "^8.64.0"
    }
  },
  "scripts": {
    "build": "turbo run build",
    "clean": "turbo run clean",
    "lint": "oxlint && turbo run lint",
    "lint:fix": "oxlint --fix && oxfmt && turbo run lint -- --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "ci:version": "changeset version && bun update",
    "ci:publish": "./scripts/ci-publish.sh"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "bun": ">=1.0.0",
    "node": ">=24"
  },
  "packageManager": "bun@1.3.13"
}
