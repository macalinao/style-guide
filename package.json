{
  "name": "@macalinao/style-guide",
  "description": "Monorepo containing ESLint and TypeScript configurations.",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/macalinao/style-guide.git"
  },
  "version": "0.1.0",
  "scripts": {
    "build": "turbo run build",
    "clean": "turbo run clean",
    "lint": "biome check && turbo run lint",
    "lint:fix": "biome check --write --unsafe && turbo run lint -- --fix",
    "format": "biome format --write",
    "format:check": "biome check --write",
    "ci:version": "changeset version && bun update",
    "ci:publish": "./scripts/ci-publish.sh"
  },
  "workspaces": {
    "packages": [
      "packages/*"
    ],
    "catalog": {
      "@biomejs/biome": "2.5.4",
      "@typescript/native": "npm:typescript@7.0.2",
      "eslint": "^10.7.0",
      "eslint-config-turbo": "2.9.18",
      "turbo": "2.9.18",
      "typescript": "npm:typescript@6.0.3",
      "typescript-eslint": "^8.64.0"
    }
  },
  "keywords": [],
  "author": "Ian Macalinao <me@ianm.com>",
  "license": "Apache-2.0",
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@changesets/cli": "^2.31.1",
    "@macalinao/biome-config": "workspace:^",
    "@typescript/native": "catalog:",
    "prettier": "^3.9.6",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=24",
    "bun": ">=1.0.0"
  },
  "packageManager": "bun@1.3.13"
}
